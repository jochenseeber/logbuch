# A prelude of its own for programs built with `--prelude=empty`: the fewest
# files of the standard prelude, in its order, that a program which traces a
# method with logbuch builds and runs with, found with Crystal 1.22 by
# dropping each file the build does without. What is left is what `log` and
# the start of a program need beyond what logbuch requires itself: it lacks
# `array`, `hash`, `mutex` and `atomic`, which logbuch requires, and `set`,
# which nothing requires.
require "lib_c"
require "macros"
require "object"
require "crystal/once"
require "comparable"
require "exception"
require "iterable"
require "steppable"
require "indexable"
